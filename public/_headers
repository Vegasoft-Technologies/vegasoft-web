# Cloudflare serves these headers with the static assets. Hashed build output never
# changes at a given path, so it can be cached for a year. The pages themselves get the
# security headers from next.config.ts; an asset is not a document, so it needs only the
# one that stops a browser guessing its type.
/*
  X-Content-Type-Options: nosniff

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# favicon.ico is the one icon Cloudflare serves itself rather than the Worker, so its
# cache lifetime cannot come from next.config.ts with the others. A week: the address
# never changes, and Google asks for it by this name.
/favicon.ico
  Cache-Control: public,max-age=604800
