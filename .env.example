# Copy to .env.local and fill in. Never commit real values.

# Deployment to Cloudflare. Only needed to deploy from a workstation; the GitHub Actions
# workflow reads the same two values from repository secrets. The token is scoped to the
# Vegasoft account only, with Workers Scripts edit permission and no zone permissions.
# Revoke and re-issue rather than share it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The contact form. On a workstation these live in .dev.vars, which git ignores; on
# Cloudflare the two secrets are Worker secrets (npx wrangler secret put NAME) and the
# site key is a build-time value the Deploy workflow reads from a repository variable.

# The public half of the Cloudflare Turnstile widget. It appears in the page's markup,
# so it is not a secret, but it is read at build time and belongs with the build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The private half, which the Worker sends to Cloudflare to check a submission.
TURNSTILE_SECRET_KEY=
# The Resend key that sends the enquiry. Scope it to sending from vegasoft.co.uk only.
RESEND_API_KEY=
